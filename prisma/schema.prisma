// Prisma schema — Instaprint Monitoring System
// Database: PostgreSQL (Neon). Timestamps disimpan UTC, dikonversi WIB di layer aplikasi.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  PIMPINAN
  STAFF
}

/// Kategori hasil normalisasi status sumber (website internal)
enum SourceStatusCategory {
  BARU
  PROSES
  SELESAI
  DIBATALKAN
  LAINNYA
}

/// Status pemantauan milik aplikasi monitoring (terpisah dari status sumber)
enum MonitoringStatus {
  BELUM_SELESAI
  SELESAI
  DIBATALKAN
}

enum StatusSource {
  AUTO
  MANUAL
}

enum ProcessType {
  DAILY_SCRAPE
  STATUS_SYNC
  MONTHLY_REVIEW
}

enum ProcessStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum ReviewStatus {
  PENDING
  DONE
  SKIPPED
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationType {
  SCRAPE_SUCCESS
  SCRAPE_FAILED
  DEADLINE_TOMORROW
  ORDER_OVERDUE
  MONTHLY_REVIEW_DONE
  REVIEW_PENDING
  STALE_ORDER
  SYNC_ERROR
}

enum MonthlyReviewStatus {
  RUNNING
  COMPLETED
  FAILED
}

model User {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  passwordHash     String    @map("password_hash")
  role             Role      @default(STAFF)
  isActive         Boolean   @default(true) @map("is_active")
  lastLoginAt      DateTime? @map("last_login_at")
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  sessions           UserSession[]
  activityLogs       ActivityLog[]
  notifications      Notification[]
  confirmedOrders    Order[]         @relation("OrderManualConfirmedBy")
  checkedReviewItems ReviewItem[]    @relation("ReviewCheckedBy")
  monthlyReviews     MonthlyReview[] @relation("MonthlyReviewCreatedBy")

  @@index([role, isActive])
  @@map("users")
}

model UserSession {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  sessionTokenHash String    @unique @map("session_token_hash")
  lastActivityAt   DateTime  @default(now()) @map("last_activity_at")
  expiresAt        DateTime  @map("expires_at")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

model Branch {
  id         String   @id @default(cuid())
  branchName String   @map("branch_name")
  branchCode String   @unique @map("branch_code")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  orders      Order[]
  reviewItems ReviewItem[]

  @@map("branches")
}

model Order {
  id                        String               @id @default(cuid())
  sourceOrderId             String               @map("source_order_id")
  orderNumber               String               @map("order_number")
  branchId                  String               @map("branch_id")
  customerName              String               @map("customer_name")
  customerPhone             String?              @map("customer_phone")
  productName               String               @map("product_name")
  orderDate                 DateTime             @map("order_date") @db.Date
  deadlineDate              DateTime?            @map("deadline_date") @db.Date
  sourceStatus              String               @map("source_status")
  sourceStatusCategory      SourceStatusCategory @default(LAINNYA) @map("source_status_category")
  monitoringStatus          MonitoringStatus     @default(BELUM_SELESAI) @map("monitoring_status")
  monitoringStatusSource    StatusSource?        @map("monitoring_status_source")
  monitoringStatusChangedAt DateTime?            @map("monitoring_status_changed_at")
  manualConfirmed           Boolean              @default(false) @map("manual_confirmed")
  manualConfirmedBy         String?              @map("manual_confirmed_by")
  manualConfirmedAt         DateTime?            @map("manual_confirmed_at")
  lastScrapedAt             DateTime?            @map("last_scraped_at")
  sourceUrl                 String?              @map("source_url")
  notes                     String?
  createdAt                 DateTime             @default(now()) @map("created_at")
  updatedAt                 DateTime             @updatedAt @map("updated_at")

  branch                Branch          @relation(fields: [branchId], references: [id])
  manualConfirmedByUser User?           @relation("OrderManualConfirmedBy", fields: [manualConfirmedBy], references: [id])
  snapshots             OrderSnapshot[]
  reviewItems           ReviewItem[]

  @@unique([branchId, sourceOrderId])
  @@index([orderDate])
  @@index([deadlineDate])
  @@index([branchId, orderDate])
  @@index([monitoringStatus, deadlineDate])
  @@index([sourceStatusCategory])
  @@index([orderNumber])
  @@index([customerName])
  @@map("orders")
}

model OrderSnapshot {
  id           String   @id @default(cuid())
  orderId      String   @map("order_id")
  sourceData   Json     @map("source_data")
  sourceStatus String   @map("source_status")
  scrapedAt    DateTime @default(now()) @map("scraped_at")
  createdAt    DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, scrapedAt])
  @@map("order_snapshots")
}

model ScrapingLog {
  id           String        @id @default(cuid())
  processType  ProcessType   @map("process_type")
  status       ProcessStatus @default(RUNNING)
  startedAt    DateTime      @default(now()) @map("started_at")
  finishedAt   DateTime?     @map("finished_at")
  totalFound   Int           @default(0) @map("total_found")
  totalCreated Int           @default(0) @map("total_created")
  totalUpdated Int           @default(0) @map("total_updated")
  totalSkipped Int           @default(0) @map("total_skipped")
  totalFailed  Int           @default(0) @map("total_failed")
  targetDate   DateTime?     @map("target_date") @db.Date
  retryOfId    String?       @map("retry_of_id")
  triggeredBy  String?       @map("triggered_by")
  errorMessage String?       @map("error_message")
  detail       Json?         @map("detail")
  createdAt    DateTime      @default(now()) @map("created_at")

  @@index([processType, startedAt])
  @@index([status])
  @@map("scraping_logs")
}

model MonthlyReview {
  id            String              @id @default(cuid())
  month         Int
  year          Int
  status        MonthlyReviewStatus @default(RUNNING)
  startedAt     DateTime            @default(now()) @map("started_at")
  finishedAt    DateTime?           @map("finished_at")
  totalOrders   Int                 @default(0) @map("total_orders")
  totalChecked  Int                 @default(0) @map("total_checked")
  totalPending  Int                 @default(0) @map("total_pending")
  createdBy     String?             @map("created_by")
  scrapingLogId String?             @map("scraping_log_id")
  errorMessage  String?             @map("error_message")
  createdAt     DateTime            @default(now()) @map("created_at")

  createdByUser User?        @relation("MonthlyReviewCreatedBy", fields: [createdBy], references: [id])
  items         ReviewItem[]

  @@unique([year, month])
  @@map("monthly_reviews")
}

model ReviewItem {
  id              String       @id @default(cuid())
  monthlyReviewId String       @map("monthly_review_id")
  orderId         String       @map("order_id")
  branchId        String       @map("branch_id")
  reviewStatus    ReviewStatus @default(PENDING) @map("review_status")
  checkedBy       String?      @map("checked_by")
  checkedAt       DateTime?    @map("checked_at")
  notes           String?
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  monthlyReview MonthlyReview @relation(fields: [monthlyReviewId], references: [id], onDelete: Cascade)
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  branch        Branch        @relation(fields: [branchId], references: [id])
  checkedByUser User?         @relation("ReviewCheckedBy", fields: [checkedBy], references: [id])

  @@unique([monthlyReviewId, orderId])
  @@index([branchId, reviewStatus])
  @@map("review_items")
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?  @map("user_id")
  action      String
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id")
  description String?
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("activity_logs")
}

model Notification {
  id         String               @id @default(cuid())
  userId     String?              @map("user_id")
  title      String
  message    String
  type       NotificationType
  priority   NotificationPriority @default(NORMAL)
  isRead     Boolean              @default(false) @map("is_read")
  relatedUrl String?              @map("related_url")
  dedupeKey  String?              @unique @map("dedupe_key")
  createdAt  DateTime             @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([type, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Pemantauan email (IMAP)
// ---------------------------------------------------------------------------

/// Satu email yang pernah terbaca saat statusnya belum dibaca.
/// Dibaca lewat IMAP dengan BODY.PEEK[], jadi mengambil isinya TIDAK mengubah
/// status belum-dibaca di mailbox asli.
model EmailMessage {
  id             String   @id @default(cuid())
  /// Alamat email pemilik pesan ini (membedakan antar-mailbox).
  accountEmail   String   @map("account_email")
  /// Folder asal, mis. INBOX.
  mailbox        String   @default("INBOX")
  /// UID IMAP; unik bersama uidValidity agar aman saat UIDVALIDITY berubah.
  uid            Int?
  uidValidity    BigInt?
  /// Header Message-ID; unik per akun agar dua mailbox tidak saling menimpa.
  messageId      String   @map("message_id")
  fromName       String?  @map("from_name")
  fromAddress    String   @map("from_address")
  subject        String
  /// Cuplikan isi (teks polos, dipotong).
  snippet        String
  receivedAt     DateTime @map("received_at")
  hasAttachments Boolean  @default(false) @map("has_attachments")
  /// true bila email sudah dibaca di mailbox (hilang dari daftar UNSEEN).
  isRead         Boolean  @default(false) @map("is_read")
  firstSeenAt    DateTime @default(now()) @map("first_seen_at")
  lastSyncedAt   DateTime @default(now()) @map("last_synced_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([accountEmail, messageId])
  @@index([accountEmail, receivedAt])
  @@index([isRead, receivedAt])
  @@map("email_messages")
}

/// Catatan setiap proses pengambilan email, untuk halaman riwayat email.
/// Terpisah dari ScrapingLog supaya riwayat order dan riwayat email tidak
/// tercampur di satu layar.
model EmailSyncRun {
  id           String    @id @default(cuid())
  /// Akun mana yang diperiksa pada proses ini.
  accountEmail String    @map("account_email")
  status       String    @default("RUNNING")
  startedAt    DateTime  @default(now()) @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  unreadFound  Int       @default(0) @map("unread_found")
  created      Int       @default(0)
  updated      Int       @default(0)
  markedRead   Int       @default(0) @map("marked_read")
  errorMessage String?   @map("error_message")
  triggeredBy  String?   @map("triggered_by")

  @@index([accountEmail, startedAt])
  @@map("email_sync_runs")
}

/// Kecepatan balas email, satu baris per percakapan (thread).
///
/// Dihitung dari Gmail: pesan masuk pertama di sebuah thread, lalu pesan
/// keluar pertama sesudahnya. Hanya metadata yang dibaca — status belum-dibaca
/// di mailbox tidak diubah.
model EmailReplyStat {
  id           String    @id @default(cuid())
  /// Mailbox pemilik percakapan; thread id hanya unik di dalam satu mailbox.
  accountEmail String    @map("account_email")
  /// ID thread Gmail, pengait pesan masuk dengan balasannya.
  threadId     String    @map("thread_id")
  subject      String
  fromName     String?   @map("from_name")
  fromAddress  String    @map("from_address")
  /// Waktu email pertama masuk di thread ini.
  receivedAt   DateTime  @map("received_at")
  /// Waktu balasan pertama terkirim; null berarti belum dibalas.
  repliedAt    DateTime? @map("replied_at")
  /// Selisih menit kalender (apa adanya, termasuk malam dan akhir pekan).
  replyMinutes Int?      @map("reply_minutes")
  /// Selisih menit yang hanya menghitung jam kerja (Sen–Jum, 08.00–17.00 WIB).
  workMinutes  Int?      @map("work_minutes")
  /// Pesan yang tidak perlu dibalas (newsletter, notifikasi sistem).
  isAutomated  Boolean   @default(false) @map("is_automated")
  /// Jumlah pesan masuk di thread ini, untuk menandai percakapan panjang.
  inboundCount Int       @default(1) @map("inbound_count")
  syncedAt     DateTime  @default(now()) @map("synced_at")

  @@unique([accountEmail, threadId])
  @@index([accountEmail, receivedAt])
  @@index([receivedAt])
  @@index([repliedAt])
  @@map("email_reply_stats")
}
