# ============================================================
# Instaprint Monitoring System — contoh konfigurasi environment
# Salin menjadi .env lalu isi nilainya. Jangan commit file .env.
# ============================================================

# --- Database (PostgreSQL) ---
# GANTI semua <...> dengan nilai asli. Format di bawah hanya contoh.
# DATABASE_URL = koneksi pooled (dipakai aplikasi)
# DIRECT_URL   = koneksi langsung (dipakai Prisma migrate)
DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require"
DIRECT_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require"

# --- Aplikasi ---
APP_NAME="Instaprint Monitoring System"
APP_TIMEZONE="Asia/Jakarta"
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
SESSION_IDLE_MINUTES=30

# --- Akun admin awal (seed) ---
SEED_ADMIN_NAME="Administrator"
SEED_ADMIN_EMAIL="admin@instaprint.local"
SEED_ADMIN_PASSWORD=""

# --- Website internal Instaprint (sumber data) ---
SOURCE_WEBSITE_URL="https://www.instasiaga.com"
SOURCE_LOGIN_URL="https://www.instasiaga.com/login"
SOURCE_ORDERS_URL="https://www.instasiaga.com/order_list"
SCRAPER_USERNAME=""
SCRAPER_PASSWORD=""
SCRAPER_HEADLESS="true"

# --- Penjadwalan ---
ENABLE_INTERNAL_CRON="0"
CRON_SECRET=""

# --- Analisis AI (endpoint OpenAI-compatible) ---
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""
