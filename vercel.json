{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "crons": [
    {
      "path": "/api/cron?job=daily",
      "schedule": "30 16 * * *"
    }
  ],
  "schedules": {
    "email-per-jam": {
      "schedule": "0 8-23 * * *",
      "timezone": "Asia/Jakarta",
      "path": "/api/email/sync",
      "requestMethod": "POST"
    }
  }
}
